{
  "name": "parasite-skill",
  "version": "1.0.0",
  "description": "Parasite skill system: enhances any AI client without modifying source code. Routes requests to the right agent skills, validates against the Agent Skills spec, and provides runtime injection, build-time hooks, and server wrapping capabilities.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "agent-skills",
    "skills",
    "parasite-skill",
    "skill-router",
    "claude-code",
    "codex",
    "opencode",
    "mcp",
    "cli",
    "runtime-injection",
    "build-hooks",
    "server-wrapping"
  ],
  "bin": {
    "parasite-skill": "bin/skill-router.js",
    "skill-router": "bin/skill-router.js"
  },
  "files": [
    "bin",
    "src",
    "skill",
    "scripts",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "bun bin/skill-router.js",
    "install:skill": "bun bin/skill-router.js install --yes",
    "scan": "bun bin/skill-router.js scan",
    "test": "bun test tests/"
  },
  "engines": {
    "node": ">=18",
    "bun": ">=1.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
