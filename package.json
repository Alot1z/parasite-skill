{
  "name": "parasite-skill",
  "version": "1.3.0",
  "description": "Local skill routing, bounded ecosystem graphing, and explicit client/MCP adapters for AI development tools.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "agent-skills",
    "skills",
    "parasite-skill",
    "claude-code",
    "codex",
    "opencode",
    "mcp",
    "cli",
    "runtime-injection",
    "build-hooks",
    "server-wrapping"
  ],
  "bin": {
    "parasite-skill": "bin/parasite-skill.js"
  },
  "files": [
    "bin/**/*.js",
    "src/**/*.js",
    "skill/SKILL.md",
    "skill/references/**/*.md",
    "skill/templates/**/*.md",
    "skill/scripts/*.py",
    "skill/scripts/*.rs",
    "scripts/*.py",
    "scripts/*.sh",
    "scripts/pack-smoke.mjs",
    "docs/**/*.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "bun bin/parasite-skill.js",
    "install:skill": "bun bin/parasite-skill.js install --yes",
    "scan": "bun bin/parasite-skill.js scan",
    "test": "bun test tests/",
    "check": "node --check bin/parasite-skill.js && node --check src/engine.js && node --check src/mcp-server.js && python -m py_compile scripts/conductor.py scripts/mcp_server.py skill/scripts/conductor.py skill/scripts/mcp_server.py",
    "pack:check": "npm pack --dry-run --json",
    "pack:smoke": "node scripts/pack-smoke.mjs"
  },
  "engines": {
    "node": ">=18",
    "bun": ">=1.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "src/index.js",
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Alot1z/parasite-skill.git"
  },
  "author": "Alot1z <16801672+Alot1z@users.noreply.github.com>",
  "bugs": {
    "url": "https://github.com/Alot1z/parasite-skill/issues"
  },
  "homepage": "https://github.com/Alot1z/parasite-skill#readme"
}
